    {
      "parameters": {
        "jsCode": "// Parsea la salida del agente y la combina con el contexto del email\nconst ctx = $('Code - Contexto Email (LTM)').first().json;\nconst raw = String($input.first().json.output || $input.first().json.text || '{}');\nlet ia = {};\ntry { ia = JSON.parse(raw.replace(/```json|```/g, '').trim()); } catch (e) { ia = {}; }\n\nconst categorias = ['SOPORTE', 'VENTAS', 'RECLAMO', 'OTRO'];\n// Nivel de riesgo: solo valores permitidos. Si falta o es inválido -> ALTO (criterio conservador)\nconst riesgoIA = String(ia.nivel_riesgo || '').toUpperCase().trim();\nconst nivelRiesgo = ['BAJO', 'MEDIO', 'ALTO'].includes(riesgoIA) ? riesgoIA : 'ALTO';\nreturn [{\n  json: {\n    ...ctx,\n    categoria: categorias.includes(ia.categoria) ? ia.categoria : 'OTRO',\n    nivel_riesgo: nivelRiesgo,\n    prioridad: ['Alta', 'Media', 'Baja'].includes(ia.prioridad) ? ia.prioridad : 'Media',\n    resumen: ia.resumen || (ctx.es_cliente_recurrente ? ctx.last_summary : 'Email: ' + ctx.subject),\n    nombre_contacto: ia.nombre_contacto || ctx.user_name,\n    respuesta_borrador: (nivelRiesgo !== 'ALTO' || ia.nivel_riesgo) && ia.respuesta_borrador ||\n      `Hola ${ctx.user_name}, recibimos tu mensaje y nuestro equipo lo está revisando. Te responderemos a la brevedad.\\n\\nEquipo de Soporte`\n  },\n  pairedItem: 0\n}];"
      },
